# x402 Resource Server Configuration

# Facilitator URL - The x402 facilitator service for payment verification/settlement
FACILITATOR_URL=http://localhost:4000

# Merchant wallet address - Where payments will be received
MERCHANT_WALLET=0xYourWalletAddressHere

# GIF URL - The URL of the GIF resource to serve after payment
GIF_URL=https://example.com/your-premium-content.gif

# Server port (optional, defaults to 3000)
PORT=3000

# Base URL for production (required when behind reverse proxy like Railway, Vercel, etc.)
# This fixes HTTPS URL generation when the proxy terminates SSL
# Example: https://qie-resource-server-production.up.railway.app
BASE_URL=

# qUSD Token Configuration on QIE Network
QUSD_ADDRESS=0xYourQUSDContractAddressHere
QUSD_DECIMALS=6
QUSD_NAME=qUSD
QUSD_VERSION=1
